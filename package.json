{
  "name": "flash-sale",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/ui"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=flash-sale-api",
    "dev:ui": "npm run dev --workspace=flash-sale-ui",
    "build": "npm run build --workspace=flash-sale-ui",
    "test": "npm test --workspace=flash-sale-api",
    "test:unit": "npm run test:unit --workspace=flash-sale-api",
    "test:integration": "npm run test:integration --workspace=flash-sale-api",
    "test:ui": "npm test --workspace=flash-sale-ui",
    "test:stress": "npm run stress --workspace=flash-sale-api",
    "format:ui": "npm run format --workspace=flash-sale-ui",
    "format:check:ui": "npm run format:check --workspace=flash-sale-ui",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  }
}
