UI_PORT=3000
API_REPLICAS=3
API_KEEP_ALIVE_TIMEOUT_MS=65000
API_HEADERS_TIMEOUT_MS=66000
API_REQUEST_TIMEOUT_MS=15000
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=512M
UI_CPU_LIMIT=0.5
UI_MEMORY_LIMIT=128M

# Use provider endpoints with automatic primary failover and backups.
DATABASE_URL=postgresql://flash_sale:replace_me@postgres-ha.example.com:5432/flash_sale
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_MAX_LIFETIME_SECONDS=300

# Use a managed Redis primary/cluster endpoint. Use rediss:// for TLS.
REDIS_URL=rediss://default:replace_me@redis-ha.example.com:6379
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_RECONNECT_MAX_DELAY_MS=2000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_JWT_SECRET=replace_with_a_long_random_secret
ADMIN_TOKEN_EXPIRES_IN=1h
